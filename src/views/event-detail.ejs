<h2><%= event.titulo %></h2>
<p><strong>Descrição:</strong> <%= event.descricao %></p>
<p><strong>Data:</strong> <%= new Date(event.data_inicio).toLocaleString('pt-BR') %></p>
<p><strong>Local:</strong> <%= event.local %></p>
<p><strong>Capacidade:</strong> <%= event.capacidade %></p>
<p><strong>Organizador:</strong> <%= event.organizador_nome %></p>

<% if (user) { %>
  <form action="/eventos/<%= event.id %>/inscrever" method="POST">
    <button class="btn" type="submit">Inscrever-se</button>
  </form>
<% } else { %>
  <p><a href="/login">Faça login</a> para se inscrever.</p>
<% } %>

<% if (user && user.tipo === 'organizador') { %>
  <div style="margin-top:1rem;">
    <a class="btn btn-secondary" href="/eventos/<%= event.id %>/editar">Editar</a>
    <form action="/eventos/<%= event.id %>/excluir" method="POST" style="display:inline-block; margin-left:0.5rem;">
      <button class="btn btn-danger" type="submit">Excluir</button>
    </form>
  </div>
<% } %>

<h3>Inscrições</h3>
<% if (subscriptions.length) { %>
  <ul>
    <% subscriptions.forEach((item) => { %>
      <li><%= item.nome %> — <%= item.email %></li>
    <% }) %>
  </ul>
<% } else { %>
  <p>Ainda não há inscrições.</p>
<% } %>
